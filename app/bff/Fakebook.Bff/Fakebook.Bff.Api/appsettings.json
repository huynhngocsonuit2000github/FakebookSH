{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Downstreams": {
    "Auth": {
      "BaseUrl": "https://localhost:5001",
      "TimeoutSeconds": 30
    }
  },
  "Jwt": {
    "Issuer": "fakebook-auth-service",
    "Audience": "fakebook-clients",
    "SigningKey": "CHANGE_ME_LOCAL_DEV_ONLY_64_CHARS_MINIMUM_1234567890ABCDEF"
  },
  "AllowedHosts": "*"
}