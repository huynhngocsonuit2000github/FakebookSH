{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Downstreams": {
    "Auth": {
      "BaseUrl": "https://localhost:7001", // [5001] for local debugging, 7001 for docker
      "TimeoutSeconds": 30
    }
  }
}