{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:4200"]
  },
  "Downstreams": {
    "Auth": {
      "BaseUrl": "http://fakebook-auth-api:8080",
      "TimeoutSeconds": 30
    }
  },
  "Jwt": {
    "Issuer": "fakebook-auth-service",
    "Audience": "fakebook-clients",
    "SigningKey": "CHANGE_ME_LOCAL_DEV_ONLY_64_CHARS_MINIMUM_1234567890ABCDEF"
  }
}
